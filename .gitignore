# Repo-wide ignores. Each Rails/React project also keeps its own .gitignore,
# and git applies both.

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# Secrets
.env
.env.*
!.env.example
**/config/master.key
**/config/credentials/*.key

# Node
node_modules/
dist/
coverage/
npm-debug.log*
yarn-error.log*

# Ruby / Rails (backup in case a project's own .gitignore misses them)
.bundle/
**/log/*.log
**/tmp/
**/storage/*.sqlite3*
**/db/*.sqlite3*
